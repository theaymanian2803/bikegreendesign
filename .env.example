# Turso (libSQL) database — https://turso.tech
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Google OAuth (storefront + admin) — https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Web application) and add the callback URL:
#   http://localhost:8080/api/auth/google/callback
#   https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Signs the httpOnly session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Comma-separated Google emails that are granted admin access on sign-in.
ADMIN_EMAILS="you@example.com"

# Optional canonical origin used to build the OAuth callback URL. When unset,
# the request origin is used (fine for local development).
APP_URL="http://localhost:8080"

# Licensing (optional — baked defaults work for the Pathway template).
# Reuses the PetPaw license Worker; mint keys with product "pathway".
LICENSE_SERVER_URL="https://petpaw-license.sberechou.workers.dev"
LICENSE_PUBLIC_KEY='{"crv":"Ed25519","kty":"OKP","x":"q2tMoDat1ek3FhSY-mBJp9FTwRQbwNSS-n8fC32REiI"}'
LICENSE_PRODUCT="pathway"

# Set to "1" only for local development/tests to bypass the admin license gate.
# LICENSE_DISABLED="1"
